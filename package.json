{
  "name": "bloody-engine",
  "version": "1.1.17",
  "description": "A WebGL-based 2.5D graphics engine for isometric rendering",
  "license": "MIT",
  "type": "module",
  "main": "dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BLooDek/bloody-engine.git"
  },
  "keywords": [
    "webgl",
    "graphics",
    "engine",
    "2.5d",
    "isometric",
    "rendering",
    "game-engine",
    "typescript",
    "nodejs"
  ],
  "bugs": {
    "url": "https://github.com/BLooDek/bloody-engine/issues"
  },
  "homepage": "https://github.com/BLooDek/bloody-engine#readme",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.config.node.ts",
    "build:node": "vite build --config vite.config.node.ts",
    "build:demo": "vite build --config vite.config.demo.ts",
    "demo": "npm run build:demo && node dist/demo/index.js",
    "demo:coordinates": "npm run build && node dist/node/examples/coordinate-systems-demo.js",
    "benchmark:collision": "tsx benchmarks/collision-benchmark.ts",
    "test:visual": "node test-visual.js",
    "test:determinism": "node test-determinism.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:state-sync": "vitest run src/state-sync.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@types/gl": "^6.0.5",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^17.2.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@kmamal/sdl": "^0.11.13",
    "gl": "^8.1.6",
    "pngjs": "^7.0.0"
  }
}
